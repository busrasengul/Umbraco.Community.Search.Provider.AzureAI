{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "7c16fc6c-a470-43cd-9dad-cfdd1c02deea",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true,
        "UnattendedUserName": "Administrator",
        "UnattendedUserEmail": "admin@example.com",
        "UnattendedUserPassword": "1234567890"
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Security": {
        "AllowConcurrentLogins": false
      }
    }
  },
  "AzureSearchProvider": {
    "Endpoint": "",
    "ApiKey": "",
    "IndexPrefix": "testsite-",
    "RegisterDefaultIndexes": false,
    "Indexes": [
      {
        "Alias": "TestSite_Content",
        "ContentTypes": [
          "searchArticle",
          "searchProduct"
        ],
        "AutoFields": true,
        "Fields": [
          {
            "PropertyName": "price",
            "FieldValues": "Decimals",
            "Facetable": true,
            "Sortable": true
          }
        ]
      },
      {
        "Alias": "TestSite_Products",
        "ContentTypes": [
          "searchProduct"
        ],
        "AutoFields": true
      }
    ]
  }
}